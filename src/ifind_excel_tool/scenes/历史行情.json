{
  "name": "历史行情",
  "description": "单只股票一段区间的日线行情与总市值。换公司改 code，换区间改 start/end；不传则按默认 2016年至今、前复权。停牌日保留，量额为0。",
  "code_required": true,
  "single_code_only": true,
  "defaults": {
    "start": "2016-01-01",
    "end": "today",
    "adjust": 108
  },
  "dims": {
    "date_range": true
  },
  "drop_non_trading_field": "非交易日判定",
  "resample": {
    "field_map": {
      "open": "开盘价",
      "high": "最高价",
      "low": "最低价",
      "close": "收盘价",
      "volume": "成交量",
      "amount": "成交额"
    }
  },
  "fields": [
    {
      "label": "非交易日判定",
      "indicator": "close_no_forward",
      "params": {
        "type": "100"
      },
      "hidden": true
    },
    {
      "label": "收盘价",
      "indicator": "ths_close_price_stock",
      "params": {
        "type": "108"
      }
    },
    {
      "label": "开盘价",
      "indicator": "ths_open_price_stock",
      "params": {
        "type": "108"
      }
    },
    {
      "label": "最高价",
      "indicator": "ths_high_price_stock",
      "params": {
        "type": "108"
      }
    },
    {
      "label": "最低价",
      "indicator": "ths_low_stock",
      "params": {
        "type": "108"
      }
    },
    {
      "label": "成交量",
      "indicator": "ths_vol_stock",
      "unit": "股",
      "params": {
        "type": "100"
      }
    },
    {
      "label": "成交额",
      "indicator": "ths_amt_stock",
      "unit": "元"
    },
    {
      "label": "总市值",
      "indicator": "market_value",
      "unit": "元",
      "params": {
        "currency": "CNY",
        "unit": 1
      }
    }
  ]
}
