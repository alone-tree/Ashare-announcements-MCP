{
  "name": "历史行情",
  "description": "单只股票一段区间的日线行情。换公司改 code，换区间改 start/end；不传则按默认 2016年至今、前复权。",
  "code_required": true,
  "single_code_only": true,
  "defaults": {
    "start": "2016-01-01",
    "end": "today",
    "adjust": 108
  },
  "dims": {"date_range": true},
  "drop_empty_rows": "成交量",
  "fields": [
    {"label": "收盘价", "indicator": "ths_close_price_stock", "params": {"type": "108"}},
    {"label": "开盘价", "indicator": "ths_open_price_stock", "params": {"type": "108"}},
    {"label": "最高价", "indicator": "ths_high_price_stock", "params": {"type": "108"}},
    {"label": "最低价", "indicator": "ths_low_stock", "params": {"type": "108"}},
    {"label": "成交量", "indicator": "ths_vol_stock", "unit": "股", "params": {"type": "100"}},
    {"label": "成交额", "indicator": "ths_amt_stock", "unit": "元"}
  ]
}
