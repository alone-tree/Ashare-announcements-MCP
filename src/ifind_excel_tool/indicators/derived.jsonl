{"name": "毛利润", "aliases": ["毛利"], "description": "营业总收入减营业成本。派生指标，底层自动取两项原始指标再相减。", "unit": "元", "decimals": 0, "expr": "营业总收入 - 营业成本", "deps": [{"label": "营业总收入", "indicator": "ths_operating_total_revenue_stock", "params": {"type": "100"}}, {"label": "营业成本", "indicator": "ths_operating_cost_stock", "params": {"type": "100"}}]}
{"name": "毛利率", "aliases": ["gross_margin"], "description": "（营业总收入−营业成本）÷营业总收入，返回百分数。口径2026-11-25定稿。", "unit": "%", "decimals": 2, "expr": "(营业总收入 - 营业成本) / 营业总收入 * 100", "deps": [{"label": "营业总收入", "indicator": "ths_operating_total_revenue_stock", "params": {"type": "100"}}, {"label": "营业成本", "indicator": "ths_operating_cost_stock", "params": {"type": "100"}}]}
{"name": "资产负债率", "aliases": [], "description": "负债合计÷资产总计，返回百分数。2026-11-26新增。", "unit": "%", "decimals": 2, "expr": "负债合计 / 资产总计 * 100", "deps": [{"label": "负债合计", "indicator": "ths_total_liab_stock", "params": {"type": "100"}}, {"label": "资产总计", "indicator": "ths_total_assets_stock", "params": {"type": "100"}}]}
{"name": "合并ROE", "aliases": ["ROE"], "description": "合并报表口径净资产收益率：净利润（含少数股东损益）÷所有者权益合计（含少数股东权益），不用归母口径。2026-11-26新增。", "unit": "%", "decimals": 2, "expr": "合并净利润 / 合并净资产 * 100", "deps": [{"label": "合并净利润", "indicator": "ths_np_stock", "params": {"type": "100"}}, {"label": "合并净资产", "indicator": "ths_total_owner_equity_stock", "params": {"type": "100"}}]}
{"name": "归母ROE", "aliases": [], "description": "归母净利润÷归属于母公司所有者权益合计，返回百分数。2026-11-26新增。", "unit": "%", "decimals": 2, "expr": "归母净利润 / 归母净资产 * 100", "deps": [{"label": "归母净利润", "indicator": "ths_np_atoopc_stock", "params": {"type": "100"}}, {"label": "归母净资产", "indicator": "ths_total_equity_atoopc_stock", "params": {"type": "100"}}]}
{"name": "四费合计", "aliases": ["期间费用"], "description": "销售费用+管理费用+研发费用+财务费用。2026-11-26新增。", "unit": "元", "decimals": 2, "expr": "销售费用 + 管理费用 + 研发费用 + 财务费用", "deps": [{"label": "销售费用", "indicator": "ths_sales_fee_stock", "params": {"type": "100"}}, {"label": "管理费用", "indicator": "ths_manage_fee_stock", "params": {"type": "100"}}, {"label": "研发费用", "indicator": "ths_rad_cost_sum_stock", "params": {"type": "100"}}, {"label": "财务费用", "indicator": "ths_financing_expenses_stock", "params": {"type": "100"}}]}
{"name": "合同负债", "aliases": ["含预收"], "description": "max(合同负债, 预收款项)。新准则报表用合同负债，老报表只有预收款项，取较大值保证口径连续。与原始科目同名时按本定义优先。2026-11-26新增。", "unit": "元", "decimals": 2, "expr": "max(合同负债, 预收款项)", "deps": [{"label": "合同负债", "indicator": "ths_contract_liab_stock", "params": {"type": "100"}}, {"label": "预收款项", "indicator": "ths_advance_payment_stock", "params": {"type": "100"}}]}
{"name": "扣非PE", "aliases": [], "description": "总市值÷扣非净利润TTM。TTM=最近4个单季度扣非净利润之和（2026-11-26定稿）；总市值取最新交易日。扣非TTM为负时返回负值。", "unit": "倍", "decimals": 2, "expr": "总市值 / 扣非TTM", "deps": [{"label": "总市值", "indicator": "market_value", "params": {"currency": "CNY", "unit": 1}, "date_mode": "latest"}, {"label": "扣非TTM", "indicator": "ths_sq_profit_nrgal_stock", "params": {"type": "100"}, "sum_periods": 4}]}
{"name": "营业收入同比", "aliases": ["营收同比"], "growth": "yoy", "unit": "%", "decimals": 2, "description": "营业总收入同比增速。公告口径：(本期-上年同期)÷|上年同期|；基期为负时附标记，基期为0或无数据时不可用。2026-11-26新增。", "deps": [{"label": "本期值", "indicator": "ths_operating_total_revenue_stock", "params": {"type": "100"}}]}
{"name": "归母净利润同比", "aliases": ["归母净利同比"], "growth": "yoy", "unit": "%", "decimals": 2, "description": "归母净利润同比增速。公告口径：(本期-上年同期)÷|上年同期|；基期为负时附标记（扭亏/减亏），基期为0或无数据时不可用。2026-11-26新增。", "deps": [{"label": "本期值", "indicator": "ths_np_atoopc_stock", "params": {"type": "100"}}]}
{"name": "扣非净利润同比", "aliases": ["扣非同比"], "growth": "yoy", "unit": "%", "decimals": 2, "description": "扣非归母净利润同比增速。公告口径：(本期-上年同期)÷|上年同期|；基期为负时附标记（扭亏/减亏），基期为0或无数据时不可用。2026-11-26新增。", "deps": [{"label": "本期值", "indicator": "ths_np_dnrgal_stock", "params": {"type": "100"}}]}
