flowchart TD
    A["请求<br/>code · amount_basis · 日期范围"] --> B{"五文件齐全<br/>且批次一致?"}
    B -- 否 --> C["建档：空框架<br/>0 期，不联网"]
    B -- 是 --> D["读缓存"]
    C --> E["枚举报告期<br/>默认最近5期；single 纳入上一期"]
    D --> E
    E --> P["探针：最新报告期<br/>1 点/代码"]
    P --> F{"有 ≤ 最新期<br/>且未拉的期?"}
    F -- 否 --> K["返回缓存"]
    F -- 是 --> G["单期 THS_BD 拉取<br/>330 码；失败退避重试 3 次"]
    G --> H{"请求成功?"}
    H -- 否 --> L["该期失败，其余期继续<br/>写进 notes"]
    H -- 是 --> N["版本合并"]
    N --> Q["每期独立提交<br/>同期四文件原子"]
    L --> Q
    Q --> K
