flowchart TD
    A["请求<br/>code · amount_basis · 日期范围"] --> B{"五文件齐全<br/>且批次一致?"}
    B -- 否 --> C["建档：写空框架<br/>0 个报告期"]
    B -- 是 --> D["读缓存"]
    C --> E["计算所需报告期<br/>请求范围 + single 前期"]
    D --> E
    E --> F{"还有缺失期?"}
    F -- 否 --> K["返回缓存"]
    F -- 是 --> G["逐期 THS_BD<br/>一次带全部 330 码"]
    G --> H{"成功?"}
    H -- 否 --> I["退避重试 3 次<br/>0.5 / 2 / 5 秒"]
    I --> J{"重试成功?"}
    J -- 否 --> L["该期失败，其余期继续<br/>写进 notes"]
    H -- 是 --> M["版本合并"]
    J -- 是 --> M
    M --> N["同批写五文件<br/>要么全写要么全不写"]
    L --> N
    N --> O{"全部成功?"}
    O -- 是 --> K
    O -- 否 --> P["有旧版本→返回旧数据 + stale<br/>无旧版本→报错"]
